# Base de datos
MONGODB_URI=

# Sesiones (cadenas largas y aleatorias, distintas entre sí)
JWT_SECRET=
USER_JWT_SECRET=

# Verificación en dos pasos del panel (fase 26b): 32 bytes aleatorios en base64, distinta en cada base.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o cambia, los admins con 2FA no pueden entrar hasta usar scripts/admin/desactivar-2fa.mjs.
TOTP_ENC_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Correo (Resend)
RESEND_API_KEY=
FROM_EMAIL=

# Sitio
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=

# Checkout: solo "true" lo activa (se lee al construir; cambiarla exige un nuevo build)
NEXT_PUBLIC_CHECKOUT_ENABLED=

# Pendiente futuro, sin uso hoy: aviso de pedido nuevo cuando se hagan los correos de pedido
# ADMIN_NOTIFY_EMAIL=
